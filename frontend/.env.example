# TruthLens AI - Frontend Environment Configuration
# FastAPI backend URL. Leave empty for same-origin deployments (Docker).
# In Vercel, set this to the public HTTPS backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Supabase Auth configuration (use the project URL and publishable key from Supabase)
# Keep these blank until a Supabase project is configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
