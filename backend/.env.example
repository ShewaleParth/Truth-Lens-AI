# TruthLens AI - Environment Configuration Example
# Copy this file to .env and fill in real values for your environment.
# Never commit .env to version control.

# ── Application Settings ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# ── CORS Settings ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth token validation for POST /api/analyze (server-side config).
# Use the project URL and publishable key; never put a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Per-user analysis throttling. Process-local; use an edge/shared limiter for replicas.
ANALYZE_RATE_LIMIT_REQUESTS=10
ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60

# ── Evidence Search Providers ────────────────────────────────────────────────
# Priority order: tavily, serper, duckduckgo. Use "none" to disable all
# external search; a "none" or "noop" entry disables search even in a mixed list.
SEARCH_PROVIDER_ORDER=tavily,serper,duckduckgo

# Tavily Search API Key (official Tavily provider; https://tavily.com)
# Automatically disabled if omitted or left blank.
TAVILY_API_KEY=

# Serper Google Search API Key (https://serper.dev)
# Automatically disabled if omitted or left blank.
SERPER_API_KEY=

# Set to true to query multiple providers for corroboration instead of stopping at first success
SEARCH_CORROBORATE_PROVIDERS=false

# ── Request Limits ──────────────────────────────────────────────────────────
# Maximum allowed claim input length (characters).
MAX_INPUT_LENGTH=5000
# Per-request timeout in seconds for external requests and analysis pipeline.
REQUEST_TIMEOUT_SECONDS=15.0

# ── Database ────────────────────────────────────────────────────────────────
# SQLite database path (relative to project root).
# Phase 7 will activate the database layer; this setting is reserved.
DATABASE_URL=sqlite:///truthlens.db

# ── Future: AI / LLM Provider ───────────────────────────────────────────────
# These keys are NOT required for Phase 2.  They will be introduced in a
# later phase when an LLM-backed verdict engine is implemented.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Future: Paid Search Provider ───────────────────────────────────────────
# Not required in Phase 2.  Uncomment and fill in when a paid provider is
# configured in a later phase.
# GOOGLE_CSE_ID=
# GOOGLE_CSE_API_KEY=
# BING_SEARCH_API_KEY=
