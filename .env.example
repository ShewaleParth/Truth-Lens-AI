# Docker Compose build-time frontend settings (public values only).
# Copy to the repository root as .env and fill these in before docker compose build.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend provider order for Docker Compose. Use exactly "none" for an
# offline/local health-only run; configured live providers may use external quota.
SEARCH_PROVIDER_ORDER=serper,duckduckgo
